# ── The Lounge ────────────────────────────────────────────────
# Accent colour (hex). Default sampled from the reference screenshots.
NEXT_PUBLIC_LOUNGE_ACCENT=#7d8ee8

# Owner login (Phase 2). Required to sign in as Elias. In production the
# placeholder password "change-me" is refused.
LOUNGE_OWNER_EMAIL=elias@example.com
LOUNGE_OWNER_PASSWORD=change-me
# Optional: separate secret for signing session cookies (defaults to a hash of
# the owner credentials, so changing the password signs everyone out).
LOUNGE_SESSION_SECRET=

# Persistence (Phase 2). Local dev defaults to file:./data/lounge.db when unset.
# On Vercel use Postgres (Neon / Vercel Postgres, pooled postgres://… URL) or a
# hosted libSQL database (Turso): libsql://<db>-<org>.turso.io
# Without DATABASE_URL on Vercel the app runs in local (in-browser) mode.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Server floor (Phase 3)
# Optional: lets an external scheduler (cron-job.org, Vercel Cron…) call
# GET /api/sim/tick with "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
# Long-running servers tick every 4s by themselves; set to "off" to disable.
LOUNGE_FLOOR_TICKER=
# Tests only: allows /api/sim/tick?rewind=<ms> (simulated absence). Keep unset in production.
LOUNGE_ALLOW_TEST_HOOKS=

# Live replies with Claude (Phase 4). Unset = built-in stub brain only (the floor
# never needs a key). Set it (and redeploy on Vercel) and NPCs who answer you
# write their reply with Claude. Backstage → "Live replies" can switch it off.
ANTHROPIC_API_KEY=
# Optional model override (default: the current Sonnet).
LOUNGE_AI_MODEL=
# Spend guard: model calls per minute across all instances (0 = off).
SIM_MAX_LLM_PER_MIN=12
