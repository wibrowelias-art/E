# ── The Lounge ────────────────────────────────────────────────
# Accent colour (hex). Default sampled from the reference screenshots.
NEXT_PUBLIC_LOUNGE_ACCENT=#7d8ee8

# Owner bootstrap (Phase 2 — auth). Not read yet in Phase 1.
LOUNGE_OWNER_EMAIL=elias@example.com
LOUNGE_OWNER_PASSWORD=change-me

# Persistence (Phase 2). libsql / Turso URL or a local file.
DATABASE_URL=file:./data/lounge.db
DATABASE_AUTH_TOKEN=

# AI provider for NPC brains (Phase 4): stub | anthropic | openai | gemini
# With no key the local stub brain keeps the server alive offline.
LOUNGE_CHAT_PROVIDER=stub
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Spend guard for live AI (Phase 4)
SIM_MAX_LLM_PER_MIN=12
