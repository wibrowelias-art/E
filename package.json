{
  "name": "the-lounge",
  "version": "0.1.0",
  "private": true,
  "description": "The Lounge — private floors. loud rooms.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "shots": "node scripts/compare.mjs",
    "smoke": "node scripts/smoke.mjs",
    "sim:check": "node scripts/sim-check.mjs",
    "db:reset": "tsx --env-file-if-exists=.env.local scripts/db.ts reset",
    "db:status": "tsx --env-file-if-exists=.env.local scripts/db.ts status",
    "api:check": "node scripts/api-check.mjs",
    "floor:check": "tsx scripts/floor-check.ts"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.2.0",
    "@libsql/client": "^0.18.0",
    "next": "15.5.29",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-virtuoso": "^4.18.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
